<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp" android:left="2dp" android:right="2dp">
        <shape><corners android:radius="18dp"/><solid android:color="#40704A08"/></shape></item>
    <item android:top="2dp">
        <shape><corners android:radius="18dp"/><solid android:color="#A3CCAD"/></shape></item>
    <item android:bottom="3dp">
        <shape><corners android:radius="18dp"/>
            <gradient android:angle="270" android:startColor="#F9FFFA" android:endColor="#DDF2E1"/></shape></item>
    <item android:bottom="3dp">
        <shape><corners android:radius="18dp"/>
            <gradient android:type="radial" android:gradientRadius="90%" android:centerX="0.2" android:centerY="0.05"
                android:startColor="#80FFFFFF" android:endColor="#00FFFFFF"/></shape></item>
    <item android:bottom="3dp">
        <shape><corners android:radius="18dp"/><stroke android:width="1dp" android:color="#B3FFFFFF"/></shape></item>
</layer-list>
