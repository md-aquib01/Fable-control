<?xml version="1.0" encoding="utf-8"?>
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/s_on" android:state_checked="true" android:drawable="@drawable/strike_on"/>
    <item android:id="@+id/s_off" android:drawable="@drawable/strike_off"/>
    <transition android:fromId="@id/s_off" android:toId="@id/s_on" android:drawable="@drawable/strike_draw"/>
    <transition android:fromId="@id/s_on" android:toId="@id/s_off" android:drawable="@drawable/strike_erase"/>
</animated-selector>
