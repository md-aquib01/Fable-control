<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <FrameLayout android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center">
        <FrameLayout android:layout_width="167dp" android:layout_height="167dp" android:layout_gravity="center"
            android:rotation="-1" android:background="@drawable/paper_sky"/>
        <FrameLayout android:layout_width="165dp" android:layout_height="165dp" android:layout_gravity="center"
            android:rotation="-7.4" android:background="@drawable/paper_cream" android:padding="6dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHOPPING LIST"
                    android:paddingStart="16dp" android:paddingTop="12dp" android:paddingBottom="10dp"
                    android:textSize="9sp" android:textStyle="bold" android:textColor="#C2B68A"/>
                <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule" android:paddingStart="16dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                        android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#3B5BD6" android:fontFamily="cursive"
                        android:checked="false" android:text="- Bread"/>
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule" android:paddingStart="16dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                        android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#3B5BD6" android:fontFamily="cursive"
                        android:checked="true" android:text="- Chocolate"/>
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule" android:paddingStart="16dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                        android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#3B5BD6" android:fontFamily="cursive"
                        android:checked="false" android:text="- Milk"/>
                </FrameLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule" android:paddingStart="16dp">
                    <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                        android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                        android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#3B5BD6" android:fontFamily="cursive"
                        android:checked="false" android:text="..."/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
