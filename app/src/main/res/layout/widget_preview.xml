<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_base" android:paddingStart="11dp" android:paddingEnd="11dp"
    android:paddingTop="11dp" android:paddingBottom="15dp">
    <FrameLayout android:id="@+id/back" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_marginTop="6dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="44dp"
        android:rotation="5" android:background="@drawable/paper_back"/>
    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="match_parent"
    android:layout_marginBottom="40dp" android:background="@drawable/paper_cream" android:paddingStart="14dp" android:paddingEnd="12dp"
    android:paddingTop="11dp" android:paddingBottom="9dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_heavy" android:textSize="10.5sp" android:letterSpacing="0.12"
            android:textAllCaps="true" android:maxLines="1" android:ellipsize="end" android:paddingBottom="3dp"
            android:textColor="#B7A26A" android:text="Shopping list"/>
        <FrameLayout android:id="@+id/r0" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c0" style="@style/Ink.Kalam" android:text="– Bread" android:checked="false"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r1" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c1" style="@style/Ink.Kalam" android:text="– Chocolate" android:checked="true"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r2" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c2" style="@style/Ink.Kalam" android:text="– Milk" android:checked="false"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r3" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c3" style="@style/Ink.Kalam" android:text="– Eggs" android:checked="false"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r4" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c4" style="@style/Ink.Kalam" android:text="– Basil, tomatoes" android:checked="false"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r5" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c5" style="@style/Ink.Kalam" android:text="– Oat biscuits" android:checked="true"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r6" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c6" style="@style/Ink.Kalam" android:visibility="invisible"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r7" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c7" style="@style/Ink.Kalam" android:visibility="invisible"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r8" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c8" style="@style/Ink.Kalam" android:visibility="invisible"/>
        </FrameLayout>
        <FrameLayout android:id="@+id/r9" android:layout_width="match_parent" android:layout_height="23dp" android:background="@drawable/rule">
            <CheckBox android:id="@+id/c9" style="@style/Ink.Kalam" android:visibility="invisible"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:layout_gravity="bottom"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="2dp" android:paddingEnd="2dp">
        <ImageView android:id="@+id/prev" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/btn_round" android:src="@drawable/ic_prev" android:padding="7dp" android:contentDescription="Previous note"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/add" android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/btn_plus" android:src="@drawable/ic_plus" android:padding="8dp" android:contentDescription="New note"/>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/next" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/btn_round" android:src="@drawable/ic_next" android:padding="7dp" android:contentDescription="Next note"/>
    </LinearLayout>
</FrameLayout>
