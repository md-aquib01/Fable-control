<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_base" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="12dp" android:paddingBottom="16dp">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="18dp"
        android:layout_marginBottom="18dp" android:background="@drawable/paper_sky"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginEnd="18dp"
        android:layout_marginTop="18dp" android:background="@drawable/paper_cream" android:paddingStart="14dp"
        android:paddingEnd="12dp" android:paddingTop="12dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHOPPING LIST"
                android:textSize="10.5sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="#8A7232"/>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="false" android:text="– Bread"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="true" android:text="– Chocolate"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="false" android:text="– Milk"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="false" android:text="– Eggs"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="false" android:text="– Tomatoes, basil"/>
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="22dp" android:background="@drawable/rule">
                <CheckBox android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@null"
                    android:background="@drawable/strike" android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                    android:paddingEnd="4dp" android:textSize="15sp" android:textColor="#1C44C4" android:fontFamily="casual"
                    android:checked="false" android:text="– Oat biscuits"/>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
