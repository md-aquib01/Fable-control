<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_base" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="12dp" android:paddingBottom="16dp">
    <StackView android:id="@+id/stack" android:layout_width="match_parent" android:layout_height="match_parent"
        android:loopViews="true"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/paper_cream" android:gravity="center" android:textSize="15sp"
        android:textColor="#1C44C4" android:text="Open Fable Notes
to write a note"/>
</FrameLayout>
