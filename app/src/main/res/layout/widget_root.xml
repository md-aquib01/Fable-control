<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/w_base" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="15dp"
    android:clipToPadding="false" android:clipChildren="true">
    <StackView android:id="@+id/stack" style="@style/NoGlowStack" android:layout_width="match_parent" android:layout_height="match_parent"
        android:loopViews="true" android:clipChildren="false" android:clipToPadding="false"/>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:layout_margin="5dp" android:background="@drawable/paper_cream" android:gravity="center" android:textSize="15sp"
        android:textColor="#1A3FB8" android:text="Open Fable Notes to write a note"/>
</FrameLayout>
