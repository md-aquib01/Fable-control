<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_media"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/w_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp">
    <ImageView
        android:id="@+id/w_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/w_art"
        android:scaleType="centerCrop" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">
        <TextView
            android:id="@+id/w_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/w_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
    <ImageView android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_prev" />
    <ImageView android:id="@+id/w_play" android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:src="@drawable/ic_play" />
    <ImageView android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp" android:padding="10dp" android:src="@drawable/ic_next" />
</LinearLayout>
